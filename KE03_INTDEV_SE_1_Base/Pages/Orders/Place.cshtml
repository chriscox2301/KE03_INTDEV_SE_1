@page "{customerId:int}"
@model KE03_INTDEV_SE_1_Base.Pages.Orders.PlaceModel
@{
    ViewData["Title"] = "Bestelling plaatsen";
}
<script src="~/js/site.js"></script>
<button class="btn btn-secondary" onclick="history.back()"><i class="bi bi-arrow-left"></i> Terug</button>

<div class="mb-4">
    <h2 class="mb-2">Bestelling plaatsen</h2>
    <p class="text-muted">Klant: @Model.Customer?.Name</p>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">Selecteer producten</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="CustomerId" />
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                @foreach (var product in Model.Products)
                {
                    <div class="col">
                        <label for="product_@product.Id" class="h-100 d-block" style="cursor: pointer;">
                            <div class="card h-100">
                                <img src="/images/products/@(product.Id).jpg" class="card-img-top" />
                                <div class="card-body">
                                    <h6 class="card-title">@product.Name</h6>
                                    <p class="card-text text-muted small">@product.Description</p>
                                </div>
                                <div class="card-footer">
                                    <strong class="text-primary">€@product.Price</strong>
                                    <input type="number" name="ProductQuantities[@product.Id]" value="0" min="0" id="product_@product.Id" data-price="@product.Price"/>
                                </div>
                            </div>
                        </label>
                    </div>
                }
            </div>
            <div class="d-flex justify-content-between align-items-center mt-3">
                <strong>Totaal: <span id="totaal" class="text-primary">€0.00</span></strong>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-cart-check"></i> Bestelling plaatsen
                </button>
            </div>
        </form>
    </div>
</div>
