@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<table class="table">
    <thead>
        <tr>
            <th>Klant</th>
            <th>Aantal Orders</th>
            <th>Acties</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model.Customers)
        {
            <tr>
                <td>@customer.Name</td>
                <td>@customer.Orders.Count()</td>
                <td>
                    <a asp-page="/Orders/Place" asp-route-customerId="@customer.Id" class="btn btn-primary">Bestelling plaatsen</a>
                    <a asp-page="/Orders/History" asp-route-customerId="@customer.Id" class="btn btn-secondary">Bestelhistorie</a>
                </td>
            </tr>
            }
    </tbody>
</table>