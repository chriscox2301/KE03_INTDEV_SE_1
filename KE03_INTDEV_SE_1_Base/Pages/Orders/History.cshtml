@page
@model KE03_INTDEV_SE_1_Base.Pages.Orders.HistoryModel
@{
    ViewData["Title"] = "Bestelhistorie";
}

<button class="btn btn-secondary" onclick="history.back()"><i class="bi bi-arrow-left"></i> Terug</button>
<h2>Bestellingen van @Model.Customer?.Name</h2>

@if (!Model.Orders.Any())
{
    <p>Geen bestellingen gevonden</p>    
}
else{
    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Order #</th>
                    <th>Datum</th>
                    <th>Producten</th>
                    <th>Totaalbedrag</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.OrderDate.ToShortDateString()</td>
                        <td>
                            <ul class="list-unstyled mb-0">
                            @foreach (var line in order.OrderLines)
                            {
                                <li><i class="bi bi-box"></i> @line.Product.Name x @line.Quantity - <strong class="text-primary">€@(line.Quantity * line.UnitPrice)</strong></li>
                            }
                            </ul>
                        </td>
                        <td><strong class="text-primary">€@order.OrderLines.Sum(l => l.Quantity * l.UnitPrice)</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
