@page "{customerId:int}"
@model KE03_INTDEV_SE_1_Base.Pages.Orders.PlaceModel
@{
    ViewData["Title"] = "Bestelling plaatsen";
}
<h2>Bestelling voor @Model.Customer?.Name</h2>

<form method="post">
    <input type="hidden" asp-for="CustomerId" />
    <h4>Selecteer producten:</h4>
    @foreach (var product in Model.Products)
    {
        <div>
            <input type="checkbox" name="SelectedProductIds" value="@product.Id" id="product_@product.Id"/>
            <label for="product_@product.Id">@product.Name - €@product.Price</label>
        </div>
    }
    <button type="submit" class="btn btn-primary">Bestelling plaatsen</button>
</form>