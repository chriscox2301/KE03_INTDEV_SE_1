@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<h1>Klantenoverzicht</h1>
<div class="table-responsive">
    <table class="table table-hover table-striped">
        <thead class="table-dark">
            <tr>
                <th>Klant</th>
                <th>Aantal Orders</th>
                <th>Acties</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Model.Customers)
            {
                <tr>
                    <td>@customer.Name</td>
                    <td>@customer.Orders.Count()</td>
                    <td>
                        <a asp-page="/Orders/Place" asp-route-customerId="@customer.Id" class="btn btn-primary me-2"><i class="bi bi-basket"></i> Bestelling plaatsen</a>
                        <a asp-page="/Orders/History" asp-route-customerId="@customer.Id" class="btn btn-outline-secondary me-2"><i class="bi bi-list"></i> Bestelhistorie</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
